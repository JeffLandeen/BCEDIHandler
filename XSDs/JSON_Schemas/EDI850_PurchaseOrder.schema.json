{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rsm:edi:bc:850:v1:json",
  "title": "EDI 850 - Purchase Order (Inbound)",
  "description": "Trading Partner -> Business Central. Maps to Sales Header/Line (Document Type = Order). PurchaseOrderNumber -> External Document No.; BuyerItemNumber -> Item Reference.",
  "type": "object",
  "properties": {
    "EDIEnvelopeInfo": {
      "$ref": "#/$defs/EDIEnvelopeInfo"
    },
    "Header": {
      "$ref": "#/$defs/Header"
    },
    "Lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Line"
      },
      "minItems": 1
    },
    "Summary": {
      "$ref": "#/$defs/Summary"
    }
  },
  "additionalProperties": false,
  "required": [
    "EDIEnvelopeInfo",
    "Header",
    "Lines"
  ],
  "$defs": {
    "Code10": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10
    },
    "Code20": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "Code35": {
      "type": "string",
      "minLength": 1,
      "maxLength": 35
    },
    "Code50": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "Text30": {
      "type": "string",
      "maxLength": 30
    },
    "Text50": {
      "type": "string",
      "maxLength": 50
    },
    "Text80": {
      "type": "string",
      "maxLength": 80
    },
    "Text100": {
      "type": "string",
      "maxLength": 100
    },
    "Text250": {
      "type": "string",
      "maxLength": 250
    },
    "Date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "Quantity": {
      "type": "number"
    },
    "Amount": {
      "type": "number"
    },
    "Percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "GTIN": {
      "type": "string",
      "pattern": "^(\\d{8}|\\d{12,14})$"
    },
    "GLN": {
      "type": "string",
      "pattern": "^\\d{13}$"
    },
    "SSCC": {
      "type": "string",
      "pattern": "^\\d{18}$"
    },
    "Measure": {
      "type": "object",
      "description": "A physical measure with its unit (weight, volume, dimension)",
      "properties": {
        "Value": {
          "$ref": "#/$defs/Quantity"
        },
        "UnitOfMeasure": {
          "$ref": "#/$defs/Code10"
        }
      },
      "required": [
        "Value",
        "UnitOfMeasure"
      ],
      "additionalProperties": false
    },
    "Address": {
      "type": "object",
      "properties": {
        "LocationCode": {
          "$ref": "#/$defs/Code20"
        },
        "GLN": {
          "$ref": "#/$defs/GLN"
        },
        "Name": {
          "$ref": "#/$defs/Text100"
        },
        "Name2": {
          "$ref": "#/$defs/Text100"
        },
        "Address": {
          "$ref": "#/$defs/Text100"
        },
        "Address2": {
          "$ref": "#/$defs/Text100"
        },
        "City": {
          "$ref": "#/$defs/Text50"
        },
        "County": {
          "$ref": "#/$defs/Text50"
        },
        "PostCode": {
          "$ref": "#/$defs/Code20"
        },
        "CountryRegionCode": {
          "$ref": "#/$defs/Code10"
        },
        "Contact": {
          "$ref": "#/$defs/Text100"
        },
        "PhoneNumber": {
          "$ref": "#/$defs/Text30"
        },
        "Email": {
          "$ref": "#/$defs/Text80"
        }
      },
      "required": [
        "Name"
      ],
      "additionalProperties": false
    },
    "Notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Text250"
      },
      "minItems": 1
    },
    "References": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "Qualifier": {
            "$ref": "#/$defs/Code10"
          },
          "Value": {
            "$ref": "#/$defs/Text100"
          }
        },
        "required": [
          "Qualifier",
          "Value"
        ],
        "additionalProperties": false
      }
    },
    "EDIEnvelopeInfo": {
      "type": "object",
      "description": "Envelope-level EDI identification, common to all RSM BC EDI documents.",
      "properties": {
        "TransactionSetCode": {
          "const": "850",
          "description": "EDI transaction set identifier (ST01 equivalent). Fixed to \"850\" in this schema."
        },
        "SourceTradingPartnerId": {
          "$ref": "#/$defs/Code35",
          "description": "Sender identifier (ISA06/GS02 equivalent)"
        },
        "DestinationTradingPartnerId": {
          "$ref": "#/$defs/Code35",
          "description": "Receiver identifier (ISA08/GS03 equivalent)"
        },
        "EDIDocumentNumber": {
          "$ref": "#/$defs/Code35",
          "description": "Unique EDI document/control number (ST02 equivalent); duplicate detection key"
        }
      },
      "required": [
        "TransactionSetCode",
        "SourceTradingPartnerId",
        "DestinationTradingPartnerId",
        "EDIDocumentNumber"
      ],
      "additionalProperties": false
    },
    "Line": {
      "type": "object",
      "properties": {
        "LineNumber": {
          "type": "integer"
        },
        "BuyerItemNumber": {
          "$ref": "#/$defs/Code50"
        },
        "SellerItemNumber": {
          "$ref": "#/$defs/Code20"
        },
        "GTIN": {
          "$ref": "#/$defs/GTIN"
        },
        "VariantCode": {
          "$ref": "#/$defs/Code10"
        },
        "Description": {
          "$ref": "#/$defs/Text100"
        },
        "QuantityOrdered": {
          "$ref": "#/$defs/Quantity"
        },
        "UnitOfMeasureCode": {
          "$ref": "#/$defs/Code10"
        },
        "UnitPrice": {
          "$ref": "#/$defs/Amount"
        },
        "LineAmount": {
          "$ref": "#/$defs/Amount"
        },
        "RequestedDeliveryDate": {
          "$ref": "#/$defs/Date"
        },
        "RequestedShipDate": {
          "$ref": "#/$defs/Date"
        },
        "ShipTo": {
          "$ref": "#/$defs/Address"
        },
        "References": {
          "$ref": "#/$defs/References"
        },
        "Notes": {
          "$ref": "#/$defs/Notes"
        }
      },
      "additionalProperties": false,
      "required": [
        "LineNumber",
        "QuantityOrdered",
        "UnitOfMeasureCode"
      ],
      "anyOf": [
        {
          "required": [
            "BuyerItemNumber"
          ]
        },
        {
          "required": [
            "SellerItemNumber"
          ]
        },
        {
          "required": [
            "GTIN"
          ]
        }
      ],
      "description": "At least one of BuyerItemNumber, SellerItemNumber, or GTIN is required."
    },
    "Header": {
      "type": "object",
      "properties": {
        "TradingPartnerId": {
          "$ref": "#/$defs/Code20"
        },
        "SenderId": {
          "$ref": "#/$defs/Code35"
        },
        "ReceiverId": {
          "$ref": "#/$defs/Code35"
        },
        "PurchaseOrderNumber": {
          "$ref": "#/$defs/Code35"
        },
        "PurchaseOrderDate": {
          "$ref": "#/$defs/Date"
        },
        "PurchaseOrderTypeCode": {
          "enum": [
            "NE",
            "RO",
            "DS",
            "SA",
            "RL"
          ],
          "description": "BEG02 equivalent: NE=New, RO=Rush, DS=Drop Ship, SA=Stand-alone, RL=Release against contract"
        },
        "RequestedDeliveryDate": {
          "$ref": "#/$defs/Date"
        },
        "RequestedShipDate": {
          "$ref": "#/$defs/Date"
        },
        "DoNotShipBeforeDate": {
          "$ref": "#/$defs/Date"
        },
        "DoNotShipAfterDate": {
          "$ref": "#/$defs/Date"
        },
        "CurrencyCode": {
          "$ref": "#/$defs/Code10"
        },
        "PaymentTermsCode": {
          "$ref": "#/$defs/Code10"
        },
        "PaymentTermsDescription": {
          "$ref": "#/$defs/Text100"
        },
        "ShipmentMethodCode": {
          "$ref": "#/$defs/Code10"
        },
        "ShippingAgentCode": {
          "$ref": "#/$defs/Code10"
        },
        "ShippingAgentServiceCode": {
          "$ref": "#/$defs/Code10"
        },
        "FreightTermsCode": {
          "$ref": "#/$defs/Code10"
        },
        "BillTo": {
          "$ref": "#/$defs/Address"
        },
        "ShipTo": {
          "$ref": "#/$defs/Address"
        },
        "References": {
          "$ref": "#/$defs/References"
        },
        "Notes": {
          "$ref": "#/$defs/Notes"
        }
      },
      "additionalProperties": false,
      "required": [
        "TradingPartnerId",
        "PurchaseOrderNumber",
        "PurchaseOrderDate",
        "ShipTo"
      ]
    },
    "Summary": {
      "type": "object",
      "properties": {
        "TotalLineCount": {
          "type": "integer"
        },
        "TotalQuantity": {
          "$ref": "#/$defs/Quantity"
        },
        "TotalAmount": {
          "$ref": "#/$defs/Amount"
        }
      },
      "additionalProperties": false
    }
  }
}

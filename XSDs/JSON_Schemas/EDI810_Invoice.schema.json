{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rsm:edi:bc:810:v1:json",
  "title": "EDI 810 - Invoice (Outbound)",
  "description": "Business Central -> Trading Partner. From Posted Sales Invoice. InvoiceNumber <- Sales Invoice Header No.; totals follow BC posted invoice math.",
  "type": "object",
  "properties": {
    "EDIEnvelopeInfo": {
      "$ref": "#/$defs/EDIEnvelopeInfo"
    },
    "Header": {
      "$ref": "#/$defs/Header"
    },
    "Lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Line"
      },
      "minItems": 1
    },
    "Totals": {
      "$ref": "#/$defs/Totals"
    }
  },
  "additionalProperties": false,
  "required": [
    "EDIEnvelopeInfo",
    "Header",
    "Lines",
    "Totals"
  ],
  "$defs": {
    "Code10": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10
    },
    "Code20": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "Code35": {
      "type": "string",
      "minLength": 1,
      "maxLength": 35
    },
    "Code50": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "Text30": {
      "type": "string",
      "maxLength": 30
    },
    "Text50": {
      "type": "string",
      "maxLength": 50
    },
    "Text80": {
      "type": "string",
      "maxLength": 80
    },
    "Text100": {
      "type": "string",
      "maxLength": 100
    },
    "Text250": {
      "type": "string",
      "maxLength": 250
    },
    "Date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "Quantity": {
      "type": "number"
    },
    "Amount": {
      "type": "number"
    },
    "Percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "GTIN": {
      "type": "string",
      "pattern": "^(\\d{8}|\\d{12,14})$"
    },
    "GLN": {
      "type": "string",
      "pattern": "^\\d{13}$"
    },
    "SSCC": {
      "type": "string",
      "pattern": "^\\d{18}$"
    },
    "Measure": {
      "type": "object",
      "description": "A physical measure with its unit (weight, volume, dimension)",
      "properties": {
        "Value": {
          "$ref": "#/$defs/Quantity"
        },
        "UnitOfMeasure": {
          "$ref": "#/$defs/Code10"
        }
      },
      "required": [
        "Value",
        "UnitOfMeasure"
      ],
      "additionalProperties": false
    },
    "Address": {
      "type": "object",
      "properties": {
        "LocationCode": {
          "$ref": "#/$defs/Code20"
        },
        "GLN": {
          "$ref": "#/$defs/GLN"
        },
        "Name": {
          "$ref": "#/$defs/Text100"
        },
        "Name2": {
          "$ref": "#/$defs/Text100"
        },
        "Address": {
          "$ref": "#/$defs/Text100"
        },
        "Address2": {
          "$ref": "#/$defs/Text100"
        },
        "City": {
          "$ref": "#/$defs/Text50"
        },
        "County": {
          "$ref": "#/$defs/Text50"
        },
        "PostCode": {
          "$ref": "#/$defs/Code20"
        },
        "CountryRegionCode": {
          "$ref": "#/$defs/Code10"
        },
        "Contact": {
          "$ref": "#/$defs/Text100"
        },
        "PhoneNumber": {
          "$ref": "#/$defs/Text30"
        },
        "Email": {
          "$ref": "#/$defs/Text80"
        }
      },
      "required": [
        "Name"
      ],
      "additionalProperties": false
    },
    "Notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Text250"
      },
      "minItems": 1
    },
    "References": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "Qualifier": {
            "$ref": "#/$defs/Code10"
          },
          "Value": {
            "$ref": "#/$defs/Text100"
          }
        },
        "required": [
          "Qualifier",
          "Value"
        ],
        "additionalProperties": false
      }
    },
    "EDIEnvelopeInfo": {
      "type": "object",
      "description": "Envelope-level EDI identification, common to all RSM BC EDI documents.",
      "properties": {
        "TransactionSetCode": {
          "const": "810",
          "description": "EDI transaction set identifier (ST01 equivalent). Fixed to \"810\" in this schema."
        },
        "SourceTradingPartnerId": {
          "$ref": "#/$defs/Code35",
          "description": "Sender identifier (ISA06/GS02 equivalent)"
        },
        "DestinationTradingPartnerId": {
          "$ref": "#/$defs/Code35",
          "description": "Receiver identifier (ISA08/GS03 equivalent)"
        },
        "EDIDocumentNumber": {
          "$ref": "#/$defs/Code35",
          "description": "Unique EDI document/control number (ST02 equivalent); duplicate detection key"
        }
      },
      "required": [
        "TransactionSetCode",
        "SourceTradingPartnerId",
        "DestinationTradingPartnerId",
        "EDIDocumentNumber"
      ],
      "additionalProperties": false
    },
    "Line": {
      "type": "object",
      "properties": {
        "PurchaseOrderLineNumber": {
          "type": "integer"
        },
        "InvoiceLineNumber": {
          "type": "integer"
        },
        "LineTypeCode": {
          "enum": [
            "Item",
            "Resource",
            "GLAccount",
            "Charge",
            "Comment"
          ],
          "default": "Item"
        },
        "BuyerItemNumber": {
          "$ref": "#/$defs/Code50"
        },
        "SellerItemNumber": {
          "$ref": "#/$defs/Code20"
        },
        "GTIN": {
          "$ref": "#/$defs/GTIN"
        },
        "VariantCode": {
          "$ref": "#/$defs/Code10"
        },
        "Description": {
          "$ref": "#/$defs/Text100"
        },
        "QuantityInvoiced": {
          "$ref": "#/$defs/Quantity"
        },
        "UnitOfMeasureCode": {
          "$ref": "#/$defs/Code10"
        },
        "UnitPrice": {
          "$ref": "#/$defs/Amount"
        },
        "LineDiscountPercent": {
          "$ref": "#/$defs/Percent"
        },
        "LineDiscountAmount": {
          "$ref": "#/$defs/Amount"
        },
        "LineAmount": {
          "$ref": "#/$defs/Amount"
        },
        "TaxAmount": {
          "$ref": "#/$defs/Amount"
        },
        "AmountIncludingTax": {
          "$ref": "#/$defs/Amount"
        },
        "Notes": {
          "$ref": "#/$defs/Notes"
        }
      },
      "additionalProperties": false,
      "required": [
        "InvoiceLineNumber",
        "Description",
        "QuantityInvoiced",
        "UnitOfMeasureCode",
        "UnitPrice",
        "LineAmount"
      ]
    },
    "TaxDetail": {
      "type": "object",
      "properties": {
        "TaxCode": {
          "$ref": "#/$defs/Code20"
        },
        "TaxDescription": {
          "$ref": "#/$defs/Text100"
        },
        "TaxPercent": {
          "$ref": "#/$defs/Percent"
        },
        "TaxableAmount": {
          "$ref": "#/$defs/Amount"
        },
        "TaxAmount": {
          "$ref": "#/$defs/Amount"
        }
      },
      "additionalProperties": false,
      "required": [
        "TaxCode",
        "TaxAmount"
      ]
    },
    "Totals": {
      "type": "object",
      "properties": {
        "TotalLineCount": {
          "type": "integer"
        },
        "TotalQuantityInvoiced": {
          "$ref": "#/$defs/Quantity"
        },
        "TotalLineAmount": {
          "$ref": "#/$defs/Amount"
        },
        "InvoiceDiscountAmount": {
          "$ref": "#/$defs/Amount"
        },
        "FreightAmount": {
          "$ref": "#/$defs/Amount"
        },
        "MiscellaneousChargeAmount": {
          "$ref": "#/$defs/Amount"
        },
        "TotalAmountExcludingTax": {
          "$ref": "#/$defs/Amount"
        },
        "TotalTaxAmount": {
          "$ref": "#/$defs/Amount"
        },
        "TotalAmountIncludingTax": {
          "$ref": "#/$defs/Amount"
        },
        "TaxDetails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TaxDetail"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "TotalLineAmount",
        "TotalAmountExcludingTax",
        "TotalAmountIncludingTax"
      ]
    },
    "Header": {
      "type": "object",
      "properties": {
        "TradingPartnerId": {
          "$ref": "#/$defs/Code20"
        },
        "InvoiceNumber": {
          "$ref": "#/$defs/Code20"
        },
        "InvoiceDate": {
          "$ref": "#/$defs/Date"
        },
        "DueDate": {
          "$ref": "#/$defs/Date"
        },
        "PurchaseOrderNumber": {
          "$ref": "#/$defs/Code35"
        },
        "PurchaseOrderDate": {
          "$ref": "#/$defs/Date"
        },
        "SalesOrderNumber": {
          "$ref": "#/$defs/Code20"
        },
        "ShipmentNumbers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Code20"
          },
          "minItems": 1
        },
        "BillOfLadingNumber": {
          "$ref": "#/$defs/Code35"
        },
        "SellToCustomerNumber": {
          "$ref": "#/$defs/Code20"
        },
        "CustomerTaxIdentificationNumber": {
          "$ref": "#/$defs/Code35"
        },
        "CurrencyCode": {
          "$ref": "#/$defs/Code10"
        },
        "PaymentTermsCode": {
          "$ref": "#/$defs/Code10"
        },
        "PaymentTermsDescription": {
          "$ref": "#/$defs/Text100"
        },
        "PaymentDiscountPercent": {
          "$ref": "#/$defs/Percent"
        },
        "PaymentDiscountDate": {
          "$ref": "#/$defs/Date"
        },
        "ShipmentMethodCode": {
          "$ref": "#/$defs/Code10"
        },
        "ShipmentDate": {
          "$ref": "#/$defs/Date"
        },
        "RemitTo": {
          "$ref": "#/$defs/Address"
        },
        "BillTo": {
          "$ref": "#/$defs/Address"
        },
        "ShipTo": {
          "$ref": "#/$defs/Address"
        },
        "Notes": {
          "$ref": "#/$defs/Notes"
        }
      },
      "additionalProperties": false,
      "required": [
        "TradingPartnerId",
        "InvoiceNumber",
        "InvoiceDate",
        "PurchaseOrderNumber"
      ]
    }
  }
}
